# Local development settings. Use a separate password for deployed environments.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=poidem
POSTGRES_PASSWORD=poidem_dev_password
POSTGRES_DB=poidem
POSTGRES_SSLMODE=disable

JWT_SECRET=local_development_secret_change_me_32_bytes
JWT_ISSUER=poydem
JWT_AUDIENCE=poydem-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
REFRESH_RETRY_WINDOW=10s
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=lax
REFRESH_COOKIE_PATH=/api/v1/auth

FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8080
OAUTH_CALLBACK_URL=http://localhost:8080/api/v1/auth/google/callback
OAUTH_FLOW_TTL=10m
# OAUTH_STATE_SECRET defaults to JWT_SECRET when omitted.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# После первого входа укажите ID пользователя и перезапустите app, чтобы назначить admin.
BOOTSTRAP_ADMIN_USER_ID=

# S3-compatible avatar storage (MinIO defaults for local development).
S3_ENDPOINT=localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=poidem_minio
S3_SECRET_KEY=poidem_minio_secret
S3_BUCKET=poidem-media
S3_REGION=us-east-1
S3_USE_SSL=false

MINIO_ROOT_USER=poidem_minio
MINIO_ROOT_PASSWORD=poidem_minio_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Published application port in Docker Compose.
APP_PORT=8080
